@inherits LayoutComponentBase
@inject ICurrentUserService CurrentUser
@inject NavigationManager Nav

<div class="app-shell">

    <aside class="sidebar">

        <div class="brand-section">
            <div class="brand">Eventify</div>
            <div class="brand-subtitle">
                Campus events, simplified.
            </div>
        </div>

        <nav class="nav flex-column">

            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <span>Dashboard</span>
            </NavLink>

            <NavLink class="nav-link" href="/events">
                <span>Discover Events</span>
            </NavLink>

            <NavLink class="nav-link" href="/my-registrations">
                <span>My Registrations</span>
            </NavLink>

            <NavLink class="nav-link" href="/profile">
                <span>My Profile</span>
            </NavLink>

            <NavLink class="nav-link" href="/organizer">
                <span>Organizer</span>
            </NavLink>
            @if (CurrentUser.IsAuthenticated)
{
    <a class="nav-link" href="#" @onclick="Logout" @onclick:preventDefault>
        <span>Log out (@CurrentUser.DisplayName)</span>
    </a>
}
else
{
    <NavLink class="nav-link" href="/login"><span>Log In</span></NavLink>
    <NavLink class="nav-link" href="/signup"><span>Sign Up</span></NavLink>
}

        </nav>

    </aside>


    <main class="main-content">

        <header class="topbar">

            <div>
                <span class="text-muted">
                    University of Ghana
                </span>
            </div>

            <div class="topbar-brand">
                Eventify
            </div>

        </header>


        <section class="page-content">

            @Body

        </section>

    </main>

</div>

@code {
    private async Task Logout()
    {
        await CurrentUser.LogoutAsync();
        Nav.NavigateTo("/");
    }
}