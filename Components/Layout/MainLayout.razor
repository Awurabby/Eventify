@inherits LayoutComponentBase
@inject ICurrentUserService CurrentUser
@inject NavigationManager Nav

<div class="app-shell @(sidebarToggled ? "sidebar-toggled" : "")">

    <aside class="sidebar">

        <div class="brand-section">
            <div class="brand">Eventify</div>
            <div class="brand-subtitle">
                Campus events, simplified.
            </div>
        </div>

        <nav class="nav flex-column">

            <NavLink class="nav-link"
                     href="/"
                     Match="NavLinkMatch.All"
                     @onclick="CloseMobileMenu">
                <span>Dashboard</span>
            </NavLink>

            <NavLink class="nav-link"
                     href="/events"
                     @onclick="CloseMobileMenu">
                <span>Discover Events</span>
            </NavLink>

            <NavLink class="nav-link"
                     href="/my-registrations"
                     @onclick="CloseMobileMenu">
                <span>My Registrations</span>
            </NavLink>

            <NavLink class="nav-link"
                     href="/profile"
                     @onclick="CloseMobileMenu">
                <span>My Profile</span>
            </NavLink>

            @if (CurrentUser.Role == "Organizer")
            {
                <NavLink class="nav-link"
                         href="/organizer"
                         @onclick="CloseMobileMenu">
                    <span>Organizer</span>
                </NavLink>
            }

            @if (CurrentUser.IsAuthenticated)
            {
                <a class="nav-link"
                   href="#"
                   @onclick="Logout"
                   @onclick:preventDefault>
                    <span>Log out (@CurrentUser.DisplayName)</span>
                </a>
            }
            else
            {
                <NavLink class="nav-link"
                         href="/login"
                         @onclick="CloseMobileMenu">
                    <span>Log In</span>
                </NavLink>

                <NavLink class="nav-link"
                         href="/register"
                         @onclick="CloseMobileMenu">
                    <span>Sign Up</span>
                </NavLink>
            }

        </nav>

    </aside>

    @if (sidebarToggled)
    {
        <button class="sidebar-overlay"
                @onclick="ToggleSidebar"
                aria-label="Close navigation">
        </button>
    }

    <main class="main-content">

        <header class="topbar">

            <div class="topbar-left">

                <button class="menu-button"
                        @onclick="ToggleSidebar"
                        aria-label="Toggle navigation">
                    ☰
                </button>

                <span class="text-muted">
                    University of Ghana
                </span>

            </div>

            <div class="topbar-brand">
                Eventify
            </div>

        </header>

        <section class="page-content">
            @Body
        </section>

    </main>

</div>

@code {

    private bool sidebarToggled = false;

    private void ToggleSidebar()
    {
        sidebarToggled = !sidebarToggled;
    }

    private void CloseMobileMenu()
    {
        sidebarToggled = false;
    }

    private async Task Logout()
    {
        sidebarToggled = false;

        await CurrentUser.LogoutAsync();

        Nav.NavigateTo("/");
    }
}