@using System.ComponentModel.DataAnnotations
@page "/organizer/create"
@inject ICurrentUserService CurrentUser
@inject EventService EventService
@inject NavigationManager Nav

<PageTitle>Create Event — Eventify</PageTitle>

<div class="container page-container">
    <a href="/organizer" class="text-decoration-none">← Organizer dashboard</a>
    <div class="detail-card mt-3">
        <h1>Create Event</h1>

        <EditForm Model="draft" OnValidSubmit="Submit">
            <DataAnnotationsValidator />

            <div class="row g-3 mt-2">
                <div class="col-12">
                    <label class="form-label">Event title</label>
                    <InputText class="form-control" @bind-Value="draft.Title"
                               placeholder="e.g. Women in Technology Forum" />
                    <ValidationMessage For="() => draft.Title" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Category</label>
                    <InputSelect class="form-select" @bind-Value="draft.Category">
                        <option>Technology</option>
                        <option>Career</option>
                        <option>Sports</option>
                        <option>Music</option>
                        <option>Entrepreneurship</option>
                    </InputSelect>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Location</label>
                    <InputText class="form-control" @bind-Value="draft.Location" placeholder="Venue" />
                    <ValidationMessage For="() => draft.Location" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Date</label>
                    <InputDate class="form-control" @bind-Value="draft.Date" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Capacity</label>
                    <InputNumber class="form-control" @bind-Value="draft.Capacity" />
                </div>
                <div class="col-12">
                    <label class="form-label">Description</label>
                    <InputTextArea class="form-control" rows="4" @bind-Value="draft.Description" />
                </div>
            </div>

            <button class="btn btn-dark mt-4" type="submit" disabled="@saving">
                @(saving ? "Publishing..." : "Publish event")
            </button>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mt-3">@errorMessage</div>
            }
        </EditForm>
    </div>
</div>

@code {
    private EventDraft draft = new();
    private bool saving;
    private string errorMessage = "";

    protected override void OnInitialized()
    {
        if (!CurrentUser.IsAuthenticated)
        {
            Nav.NavigateTo("/login?returnUrl=/organizer/create");
        }
    }

    private async Task Submit()
    {
        saving = true;
        errorMessage = "";

        try
        {
            var eventItem = new EventItem
            {
                Title = draft.Title,
                Category = draft.Category,
                Location = draft.Location,
                Date = draft.Date,
                Capacity = draft.Capacity,
                Description = draft.Description,
                Organizer = CurrentUser.DisplayName ?? "Unknown organizer"
            };

            await EventService.AddEventAsync(eventItem);
            Nav.NavigateTo($"/events/{eventItem.Id}");
        }
        catch (Exception)
        {
            errorMessage = "Something went wrong publishing this event. Please try again.";
            saving = false;
        }
    }

    private class EventDraft
    {
        [Required(ErrorMessage = "Title is required")]
        public string Title { get; set; } = "";

        public string Category { get; set; } = "Technology";

        [Required(ErrorMessage = "Location is required")]
        public string Location { get; set; } = "";

        public DateTime Date { get; set; } = DateTime.Today.AddDays(7);

        public int Capacity { get; set; } = 100;

        public string Description { get; set; } = "";
    }
}