@page "/login"
@inject AntiforgeryStateProvider AntiforgeryStateProvider

<PageTitle>Log in</PageTitle>

<div class="container py-5" style="max-width: 420px;">
    <h1>Log in</h1>

    @if (Error is not null)
    {
        <div class="alert alert-danger">Incorrect email or password.</div>
    }

    <form method="post" action="/account/login">
        <input type="hidden" name="__RequestVerificationToken" value="@GetAntiforgeryToken()" />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control" type="email" name="email" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Password</label>
            <input class="form-control" type="password" name="password" required />
        </div>

        <button class="btn btn-primary" type="submit">Log in</button>
    </form>

    <p class="mt-3">
        No account yet? <a href="/register">Register here</a>.
    </p>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private string? GetAntiforgeryToken() => AntiforgeryStateProvider.GetAntiforgeryToken()?.Value;
}