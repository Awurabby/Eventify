@page "/login"
@inject StubCurrentUserService CurrentUser
@inject NavigationManager Nav

<PageTitle>Log In — Eventify</PageTitle>

<div class="container page-container">
    <div class="detail-card" style="max-width:420px;margin:0 auto;">
        <h1>Log In</h1>
        <p class="text-muted">Placeholder — auth teammate will replace this with the real form.</p>
        <button class="btn btn-dark mt-3" @onclick="SimulateLoginAndReturn">
            (Temporary) Simulate login
        </button>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private void SimulateLoginAndReturn()
    {
        CurrentUser.SimulateLogin();
        Nav.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl);
    }
}