@page "/organizer"

<PageTitle>Organizer Dashboard — Eventify</PageTitle>

<div class="container-fluid page-container">
    <div class="page-heading">
        <div>
            <h1>Organizer Dashboard</h1>
            <p>Manage events and monitor registrations.</p>
        </div>
        <a class="btn btn-dark" href="/organizer/create">+ Create event</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="stat-card"><span>Published events</span><strong>6</strong></div></div>
        <div class="col-md-4"><div class="stat-card"><span>Total registrations</span><strong>184</strong></div></div>
        <div class="col-md-4"><div class="stat-card"><span>Upcoming events</span><strong>3</strong></div></div>
    </div>

    <div class="detail-card">
        <h3>Next event</h3>
        <p class="mb-1"><strong>Campus Tech Meetup</strong></p>
        <p class="text-muted">Friday · New Lecture Theatre · 42 registrations</p>
        <a class="btn btn-outline-dark" href="/organizer/create">Manage event</a>
    </div>
</div>
