@page "/organizer"
@inject ICurrentUserService CurrentUser
@inject EventService EventService
@inject RegistrationService RegistrationService
@inject NavigationManager Nav

<PageTitle>Organizer Dashboard — Eventify</PageTitle>

<div class="container-fluid page-container">
    <div class="page-heading">
        <div>
            <h1>Organizer Dashboard</h1>
            <p>Manage events and monitor registrations.</p>
        </div>
        <a class="btn btn-dark" href="/organizer/create">+ Create event</a>
    </div>

    @if (loading)
    {
        <p class="text-muted">Loading dashboard...</p>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-4"><div class="stat-card"><span>Published events</span><strong>@totalEvents</strong></div></div>
            <div class="col-md-4"><div class="stat-card"><span>Total registrations</span><strong>@totalRegistrations</strong></div></div>
            <div class="col-md-4"><div class="stat-card"><span>Upcoming events</span><strong>@upcomingEvents</strong></div></div>
        </div>

        <div class="detail-card">
            <h3>Next event</h3>
            @if (nextEvent is not null)
            {
                <p class="mb-1"><strong>@nextEvent.Title</strong></p>
                <p class="text-muted">@nextEvent.Date.ToString("dddd") · @nextEvent.Location · @nextEventRegistrations registrations</p>
                <a class="btn btn-outline-dark" href="/events/@nextEvent.Id">View event</a>
            }
            else
            {
                <p class="text-muted">No upcoming events yet.</p>
            }
        </div>
    }
</div>

@code {
    private bool loading = true;
    private int totalEvents;
    private int totalRegistrations;
    private int upcomingEvents;
    private EventItem? nextEvent;
    private int nextEventRegistrations;

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsAuthenticated || CurrentUser.Role != "Organizer")
        {
            Nav.NavigateTo("/login?returnUrl=/organizer");
            return;
        }

        var events = await EventService.GetEventsAsync();

        totalEvents = events.Count;
        totalRegistrations = await RegistrationService.GetTotalRegistrationCountAsync();
        upcomingEvents = events.Count(e => e.Date >= DateTime.Today);

        nextEvent = events
            .Where(e => e.Date >= DateTime.Today)
            .OrderBy(e => e.Date)
            .FirstOrDefault();

        if (nextEvent is not null)
        {
            nextEventRegistrations = await RegistrationService.GetRegistrationCountForEventAsync(nextEvent.Id);
        }

        loading = false;
    }
}